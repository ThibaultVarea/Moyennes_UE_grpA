from tkinter import *
from tkinter import ttk


def affichage_moy_tkinter():
    
    fenetre = Tk()
    
    affichage1=ttk.Label(fenetre, text="Semestre 1", )
    affichage1.grid(column=0, row=0, padx=20, pady=0)

    matieres= [f"R{i}" for i in range(101, 116)] + [f"SAE{i}" for i in range(11,17)]     # On crée un tableau contenant R101, R102 puis SAE13, SAE14 etc.

    frame = ttk.Frame(fenetre) # création de la fenêtre
    frame.grid()
    saisies = []     # on crée une liste vide qui contiendra les notes plus tard
    
    for i,matiere in enumerate(matieres):
        ressource=ttk.Label(frame, text=f"{matiere}: ")    # texte (la valeur actuelle de matiere)
        saisie=ttk.Entry(frame, width=5)
        ressource.grid(column=1, row=i)     # on affiche le texte contenant la valeur actuelle de matiere
        saisie.grid(column=2, row=i)     # on affiche la case de la saisie
        saisies.append(saisie)     # on ajoute la saisie à la liste notes
    
    def calcmoy():     #Definition de la fonction qui calcule la moyenne
        notes = [float(saisie.get()) for saisie in saisies]
        moy = sum(notes) / len(matieres)
        resultat = ttk.Label(frame, text=f"Sur le semestre 1, votre moyenne est de {moy}")
        resultat.grid(column=3, row=4)
    
    bouton = ttk.Button(frame, text="Effectuer la moyenne", command = calcmoy)
    bouton.grid(column=3, row=2, padx=100)
    
    fenetre.mainloop()
affichage_moy_tkinter()
